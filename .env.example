# Supabase — copy to .env.local and fill in.
# URL + publishable/anon key are safe for the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Base URL of the superkalan-crm-api backend (NestJS). User management and all
# future CRM operations go through it — this app never talks to the DB directly.
NEXT_PUBLIC_API_URL=

